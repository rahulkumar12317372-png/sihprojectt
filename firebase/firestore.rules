rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'ADMIN' || request.auth.token.admin == true);
    }

    function isResponder() {
      return isAuthenticated() && getUserRole() == 'RESPONDER';
    }

    function isHospital() {
      return isAuthenticated() && getUserRole() == 'HOSPITAL';
    }

    // Users collection: Private profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Incidents collection: Emergency incidents
    match /incidents/{incidentId} {
      // User can read their own incident; assigned responder, hospital and admin can read
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.responderId == request.auth.uid ||
        isAdmin() ||
        isResponder() ||
        isHospital()
      );

      // Anyone authenticated can create an emergency SOS incident
      allow create: if isAuthenticated();

      // Updates restricted to owner, assigned responder, hospital or admin
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.responderId == request.auth.uid ||
        isAdmin() ||
        isResponder() ||
        isHospital()
      );

      allow delete: if isAdmin();
    }

    // Responders collection: Availability and coordinates
    match /responders/{responderId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(responderId) || isAdmin();
    }

    // Hospitals collection: Capacity & readiness
    match /hospitals/{hospitalId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(hospitalId) || isAdmin();
    }

    // Trusted Contacts collection
    match /trustedContacts/{contactId} {
      allow read, write: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // Notifications collection: Private alerts
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated();
    }

    // Public aggregate analytics (Read-only summary)
    match /analytics/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
